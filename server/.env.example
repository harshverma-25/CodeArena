# Server Configuration
PORT=5000
NODE_ENV=development # Options: development, production, test

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/codearena

# Clerk Authentication Keys
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Judge0 Execution Service Configuration
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=judge0_api_key_placeholder
JUDGE0_POLL_INTERVAL=1000 # Milliseconds between status polls
JUDGE0_MAX_POLL_ATTEMPTS=15 # Max poll queries before timeout

# Network & Logging Controls
CORS_ORIGIN=* # Allowed CORS origin domain
LOG_LEVEL=info # Pino log level (info, debug, warn, error)
